{
  "name": "impromptu",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @impromptu/api && npm run build -w @impromptu/web",
    "ci": "sh scripts/ci.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run build -w @impromptu/api && oxlint --type-aware --deny-warnings .",
    "prepare": "node .husky/install.mjs",
    "test": "npm run build -w @impromptu/api && vitest run",
    "test:e2e": "npm run build -w @impromptu/api && playwright test --config apps/web/playwright.config.ts",
    "typecheck": "npm run typecheck -w @impromptu/api && npm run typecheck -w @impromptu/web"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
